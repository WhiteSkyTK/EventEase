@model EventEase.Models.Event

@{
    ViewData["Title"] = "Modify Event";
}

<div class="container py-4">
    <div class="card border-3 shadow-sm" style="border-radius: 20px; border: 3px solid #000;">
        <div class="card-header bg-warning py-3">
            <h2 class="fw-bold mb-0">✏️ Modify Event</h2>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger fw-bold mb-3"></div>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger border-2 mb-3">@TempData["Error"]</div>
                }

                <input type="hidden" asp-for="EventId" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventName" class="fw-bold"></label>
                        <input asp-for="EventName" class="form-control border-2" />
                        <span asp-validation-for="EventName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="EventTypeId" class="fw-bold">Event Category</label>
                        <select asp-for="EventTypeId" class="form-control border-2" asp-items="ViewBag.EventTypeId">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="EventTypeId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="VenueId" class="fw-bold">Location</label>
                        <select asp-for="VenueId" class="form-control border-2" asp-items="ViewBag.VenueId"></select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="StartDateTime" class="fw-bold">Starts At</label>
                        <input asp-for="StartDateTime" class="form-control border-2" type="datetime-local" />
                        <span asp-validation-for="StartDateTime" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="EndDateTime" class="fw-bold">Ends At</label>
                        <input asp-for="EndDateTime" class="form-control border-2" type="datetime-local" />
                        <span asp-validation-for="EndDateTime" class="text-danger"></span>
                    </div>

                    <div class="col-12 mb-4">
                        <label asp-for="Description" class="fw-bold"></label>
                        <textarea asp-for="Description" class="form-control border-2" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-4 p-4 border-3 rounded-4 bg-light" style="border: 3px dashed #000;">
                    <label class="fw-bold d-block mb-2">📸 Event Poster</label>
                    <div class="row align-items-center">
                        <div class="col-md-3 text-center border-end border-2">
                            <img id="preview" src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://placehold.co/150x150?text=Poster" : Model.ImageUrl)" class="img-fluid rounded-3" style="max-height: 120px;" />
                        </div>
                        <div class="col-md-4">
                            <label class="small fw-bold">Upload New File</label>
                            <input type="file" name="imageFile" id="imageFileInput" class="form-control border-2" accept="image/*" />
                        </div>
                        <div class="col-md-5">
                            <label class="small fw-bold">Or External Image URL</label>
                            <input asp-for="ImageUrl" id="imageUrlInput" class="form-control border-2" />
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-dark btn-lg px-5 fw-bold" style="border-radius: 12px;">Update Event</button>
                    <a asp-action="Index" class="btn btn-outline-dark btn-lg px-4 ms-2" style="border-radius: 12px;">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-outline-dark fw-bold border-3 shadow-sm px-4" style="border-radius: 12px;">
        ⬅️ Return to List
    </a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('imageUrlInput').addEventListener('input', function() {
            if (this.value) document.getElementById('preview').src = this.value;
        });
        document.getElementById('imageFileInput').addEventListener('change', function() {
            if (this.files[0]) document.getElementById('preview').src = URL.createObjectURL(this.files[0]);
        });
    </script>
}