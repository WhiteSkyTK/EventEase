@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model EventEase.Models.Event

@{
    ViewData["Title"] = "Event Details";
    var userRole = HttpContextAccessor.HttpContext.Session.GetString("UserRole");
}

<div class="container py-5">
    <div class="card border-4 shadow-lg mx-auto" style="border: 4px solid #000; border-radius: 30px; overflow: hidden; max-width: 900px; background-color: #fff;">

        <div class="bg-primary text-white p-4 text-center" style="border-bottom: 4px dashed #fff; position: relative;">
            <h1 class="fw-bold mb-0">🎫 EVENT TICKET</h1>
            <div style="position: absolute; bottom: -15px; left: -15px; width: 30px; height: 30px; background: #f0f2f5; border-radius: 50%; border: 4px solid #000;"></div>
            <div style="position: absolute; bottom: -15px; right: -15px; width: 30px; height: 30px; background: #f0f2f5; border-radius: 50%; border: 4px solid #000;"></div>
        </div>

        <div class="card-body p-4 p-md-5">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="text-center mb-5">
                    <img src="@Model.ImageUrl"
                         class="img-fluid rounded-4 shadow border border-3 border-dark"
                         style="max-height: 400px; width: 100%; object-fit: cover;"
                         alt="Event Poster" />
                </div>
            }

            <h2 class="display-5 fw-bold text-center mb-4" style="color: #000; letter-spacing: -1px;">@Model.EventName</h2>

            <div class="row g-4 text-center">
                <div class="col-md-4">
                    <div class="p-3 h-100 border-3 rounded-4" style="border: 3px solid #000; background-color: #f8f9fa;">
                        <p class="text-muted mb-1 fw-bold small text-uppercase">Starts</p>
                        <h5 class="fw-bold mb-0">📅 @Model.StartDateTime.ToString("MMM dd, yyyy")</h5>
                        <small class="fw-bold text-primary">@Model.StartDateTime.ToString("t")</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 h-100 border-3 rounded-4" style="border: 3px solid #000; background-color: #f8f9fa;">
                        <p class="text-muted mb-1 fw-bold small text-uppercase">Ends</p>
                        <h5 class="fw-bold mb-0">⌛ @Model.EndDateTime.ToString("MMM dd, yyyy")</h5>
                        <small class="fw-bold text-primary">@Model.EndDateTime.ToString("t")</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 h-100 border-3 rounded-4" style="border: 3px solid #000; background-color: #f8f9fa;">
                        <p class="text-muted mb-1 fw-bold small text-uppercase">Location</p>
                        <h5 class="fw-bold mb-0">📍 @(Model.Venue?.VenueName ?? "TBA")</h5>
                    </div>
                </div>
            </div>

            <div class="mt-5">
                <h5 class="fw-bold text-uppercase small text-muted mb-3">About this Event</h5>
                <div class="fs-5 p-4 border-2 rounded-4" style="border: 2px solid #eee; background-color: #fafafa; line-height: 1.6;">
                    @Model.Description
                </div>
            </div>

            <div class="mt-5 d-flex flex-column flex-md-row gap-3">
                @if (userRole == "Admin")
                {
                    <a asp-action="Edit" asp-route-id="@Model.EventId" class="btn btn-warning btn-lg fw-bold flex-grow-1 border-3 border-dark" style="border-radius: 15px;">
                        ✏️ Modify Event
                    </a>
                }
                <a asp-action="Index" class="btn btn-dark btn-lg fw-bold flex-grow-1 border-3 border-dark" style="border-radius: 15px;">
                    ⬅️ Back to Schedule
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #f0f2f5; /* High contrast background */
    }
</style>