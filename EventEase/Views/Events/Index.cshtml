@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model IEnumerable<EventEase.Models.Event>

@{
    ViewData["Title"] = "Event Schedule";
    var userRole = HttpContextAccessor.HttpContext.Session.GetString("UserRole");
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h1 class="fw-bold display-4" style="letter-spacing: -1px;">📅 The Schedule</h1>
        @if (userRole == "Admin")
        {
            <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm fw-bold px-4" style="border-radius: 15px; border: 3px solid #000;">
                ✨ New Event
            </a>
        }
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-3 mb-4 shadow" style="border-radius: 15px; border: 2px solid #000;">
            <strong>@TempData["Error"]</strong>
        </div>
    }

    <div class="card p-4 mb-4 border-3 shadow-sm" style="border-radius: 20px; background-color: white; border: 3px solid #000;">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="fw-bold mb-1">Search Name or ID</label>
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="e.g. 1 or Gala..." />
            </div>
            <div class="col-md-3">
                <label class="fw-bold mb-1">Category</label>
                <select name="eventTypeId" class="form-select" asp-items="ViewBag.EventTypes">
                    <option value="">-- All Categories --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="fw-bold mb-1">From Date</label>
                <input type="date" name="startDate" value="@ViewData["StartDate"]" class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 fw-bold">🔍 Filter</button>
            </div>
        </form>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-12">
                    <div class="card border-4 shadow-lg overflow-hidden" style="border-radius: 25px; border-color: #000; background: #fff;">
                        <div class="row g-0">
                            <div class="col-md-3" style="min-height: 200px;">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://placehold.co/600x400?text=No+Poster+Available" : item.ImageUrl)"
                                     class="img-fluid h-100 w-100" style="object-fit: cover; border-right: 4px solid #000;" alt="Poster">
                            </div>

                            <div class="col-md-6 p-4 d-flex flex-column justify-content-center">
                                <div class="mb-2">
                                    <span class="badge bg-warning text-dark border border-2 border-dark fw-bold">CONFIRMED</span>

                                    <!-- ADDED: Category Badge -->
                                    <span class="badge bg-info text-dark border border-2 border-dark fw-bold ms-1">
                                        @item.EventType?.TypeName.ToUpper()
                                    </span>

                                    <span class="ms-2 text-muted fw-bold small">ID: #EE-@item.EventId</span>
                                </div>
                                <h2 class="fw-bold mb-1" style="color: #000;">@item.EventName</h2>
                                <p class="text-primary fw-bold mb-3 fs-5">
                                    📍 @(item.Venue?.VenueName ?? "Venue TBA")
                                </p>
                                <div class="d-flex gap-4">
                                    <div>
                                        <small class="text-muted d-block fw-bold">DATE</small>
                                        <span class="fw-bold">@item.StartDateTime.ToString("MMM dd, yyyy")</span>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block fw-bold">TIME</small>
                                        <span class="fw-bold">@item.StartDateTime.ToString("hh:mm tt")</span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3 p-4 bg-light d-flex flex-column justify-content-center align-items-center"
                                 style="border-left: 4px dashed #000; background-color: #f8f9fa !important;">
                                <a asp-action="Details" asp-route-id="@item.EventId" class="btn btn-dark w-100 mb-2 fw-bold py-2" style="border-radius: 10px;">
                                    VIEW DETAILS
                                </a>
                                @if (userRole == "Admin")
                                {
                                    <div class="d-flex gap-2 w-100">
                                        <a asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-outline-dark fw-bold flex-grow-1" style="border-width: 2px;">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@item.EventId" class="btn btn-danger fw-bold flex-grow-1" style="border: 2px solid #000;">Del</a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <h2 class="display-1">🎈</h2>
                <h4 class="text-muted fw-bold">The schedule is clear!</h4>
                <p>Time to add some whimsical events.</p>
            </div>
        }
    </div>

    <div class="mt-5 pb-5">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark border-2 fw-bold">
            ← Back to Home
        </a>
    </div>
</div>

<style>
    body {
        background-color: #f0f2f5; /* Light gray background makes the white tickets "pop" */
    }

    .card {
        transition: transform 0.2s ease;
    }

        .card:hover {
            transform: scale(1.01);
        }
</style>