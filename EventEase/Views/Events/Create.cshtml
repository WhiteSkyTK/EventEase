@model EventEase.Models.Event

@{
    ViewData["Title"] = "Schedule New Event";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">📅 Schedule an Event</h1>
        <a asp-action="Index" class="btn btn-outline-dark">← Back to List</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card border-4 p-4 shadow-lg" style="border-radius: 25px; border-color: #000;">
                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="EventName" class="form-label fw-bold">Event Name</label>
                                <input asp-for="EventName" class="form-control border-2" placeholder="e.g. Smith Wedding Reception" />
                                <span asp-validation-for="EventName" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label fw-bold">Description</label>
                                <textarea asp-for="Description" class="form-control border-2" rows="4" placeholder="Tell us about the event..."></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="fw-bold">Start Date & Time</label>
                                <input asp-for="StartDateTime" class="form-control border-2" type="datetime-local" />
                                <span asp-validation-for="StartDateTime" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="fw-bold">End Date & Time</label>
                                <input asp-for="EndDateTime" class="form-control border-2" type="datetime-local" />
                                <span asp-validation-for="EndDateTime" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="VenueId" class="form-label fw-bold">Assign Venue</label>
                                <select asp-for="VenueId" class="form-select border-2" asp-items="ViewBag.VenueId">
                                    <option value="">-- Optional: Assign Later --</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" style="border-top: 2px dashed #000; opacity: 1;">

                    <div class="mb-4">
                        <label class="fw-bold d-block mb-2">📸 Event Poster / Image</label>
                        <div class="p-4 border-3 rounded-4 bg-light" style="border: 3px dashed #000;">
                            <div class="row align-items-center">
                                <div class="col-md-3 text-center border-end border-2">
                                    <div class="bg-white p-2 rounded-3 shadow-sm mb-2">
                                        <img id="preview" src="https://placehold.co/150x150?text=Poster" alt="Event Preview" class="img-fluid rounded-3" style="max-height: 120px;" />
                                    </div>
                                    <p class="small text-muted fw-bold">Poster Preview</p>
                                </div>
                                <div class="col-md-4">
                                    <label class="small fw-bold">Upload New File</label>
                                    <input type="file" name="imageFile" id="imageFileInput" class="form-control border-2" accept="image/*" />
                                </div>
                                <div class="col-md-5">
                                    <label class="small fw-bold">Or External Image URL</label>
                                    <input asp-for="ImageUrl" id="imageUrlInput" class="form-control border-2" placeholder="https://..." />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary btn-lg w-100 py-3 fw-bold shadow" style="border-radius: 15px; border: 3px solid #000;">
                            ✨ CREATE NEW EVENT
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Simple preview logic for the URL input
        document.getElementById('imageUrlInput').addEventListener('input', function() {
            var url = this.value;
            if (url) {
                document.getElementById('preview').src = url;
            }
        });

        // Simple preview logic for the File input
        document.getElementById('imageFileInput').addEventListener('change', function() {
            var file = this.files[0];
            if (file) {
                document.getElementById('preview').src = URL.createObjectURL(file);
            }
        });
    </script>
}