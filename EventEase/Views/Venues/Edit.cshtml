@model EventEase.Models.Venue

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Venue</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="VenueId" />

            <div class="form-group mb-3">
                <label asp-for="VenueName" class="control-label fw-bold"></label>
                <input asp-for="VenueName" class="form-control" />
                <span asp-validation-for="VenueName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Location" class="control-label fw-bold"></label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Capacity" class="control-label fw-bold"></label>
                <input asp-for="Capacity" class="form-control" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>

            <div class="form-group mb-4 p-3 bg-light border rounded">
                <label class="control-label fw-bold mb-2">Venue Image</label><br />

                <img src="@Model.ImageUrl" id="imagePreview" alt="Venue Preview" class="img-thumbnail mb-3" style="max-height: 120px;" />

                <label class="small text-muted d-block mb-1">Upload New File</label>
                <input type="file" name="imageFile" class="form-control mb-2" accept="image/*" />

                <label class="small text-muted d-block mb-1">Or edit Image URL manually</label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save Changes" class="btn btn-primary btn-lg w-100" />
            </div>
        </form>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-outline-dark fw-bold border-3 shadow-sm px-4" style="border-radius: 12px;">
        ⬅️ Return to List
    </a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.querySelector('input[name="imageFile"]').addEventListener('change', function (event) {
            const [file] = event.target.files;
            if (file) {
                document.getElementById('imagePreview').src = URL.createObjectURL(file);
            }
        });
    </script>
}